# -----------------------------------------------------------------------------
# Настройки Apache для размещения приложения в каталоге public/.
#
# Если каталог публичной части отличается от корня сайта, рядом с проектом
# должен лежать ещё и корневой .htaccess: он переводит адреса в public/ и
# закрывает служебные каталоги. На nginx оба файла не действуют — см. deploy/
# и раздел «Развёртывание» в README.md.
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Если каталог публичной части отличается от корня сайта,
    # раскомментируйте и подставьте свой путь:
    # RewriteBase /my-edu/

    # Служебное наружу не отдаём.
    #
    # Корневой .htaccess урезан до одной директивы mod_rewrite намеренно:
    # запрет Options, Require, FilesMatch или Header зависит от того, какие
    # секции разрешены хостингом через AllowOverride, и запрет любой из них
    # даёт 500 на все адреса разом. Здесь — наоборот, отступать некуда: без
    # этого файла сайт не открывается вовсе, и «удалите .htaccess» как
    # аварийный приём не работает. Поэтому в файле остаются только
    # RewriteEngine и RewriteRule — они разрешены везде, где вообще работает
    # .htaccess, — а всё остальное сделано ими же.
    #
    # Заголовки безопасности приложение выставляет само в каждом ответе
    # (src/Core/Response.php), поэтому mod_headers здесь не нужен.
    RewriteRule ^(?:config|database|src|plugins|tools|vendor|var)(?:/|$) - [F,L]
    RewriteRule (?:README\.md|changelog\.md|ПРОДОЛЖИТЬ_РАБОТУ\.md|\.gitignore|\.git|\.htaccess)$ - [F,L]
    RewriteRule \.(?:sql|log|bak|ini|db|sqlite|env)$ - [F,L]

    # Каталог tests не закрывается целиком — это публичный адрес плагина
    # «Тест». Адрес /tests/task/{id} принимает сохранение задания, и в закрытом
    # виде нажатие «Сохранить» уходило в 403 до PHP: правка терялась, а
    # человек видел ошибку сервера вместо результата.
    #
    # Поэтому запрещаются сами файлы набора, а не префикс. Внутри public/
    # каталога tests и нет — правило нужно для варианта, где корень сайта
    # смотрит в каталог проекта, и защищает утечку исходников проверок.
    RewriteRule ^tests/(?:run_[\w]+\.php|support/.*|.*\.(?:sql|md|json|lock))$ - [F,L]

    # Все адреса, кроме файлов и каталогов, идут в front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>