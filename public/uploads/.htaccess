# -----------------------------------------------------------------------------
# Каталог загруженных картинок.
#
# Сюда попадают файлы из визуального редактора вопроса. Два правила, и оба
# обязательны:
#
#   1. Ничего из этого каталога не исполняется. Даже если имя файла почему-то
#      окажется с расширением .php, сервер отдаст его текстом, а не выполнит.
#      Это подстраховка к проверке содержимого: полагаться только на неё
#      значило бы считать, что проверка никогда не ошибётся.
#
#   2. PHP внутри каталога не запускается вовсе, даже если каталог почему-то
#      окажется целью обработчика.
# -----------------------------------------------------------------------------

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_headers.c>
    # Картинка должна отрисоваться как картинка, а не как страница. Без этого
    # браузер запрошенный адрес из содержимого файла не определит, и объект
    # в вопросе не покажется.
    <FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
        Header set X-Content-Type-Options "nosniff"
        Header set Content-Disposition "inline"
    </FilesMatch>
</IfModule>

# Скрытый каталог, даже если кто-то его создаст.
RedirectMatch 404 /\.