# Локальные настройки с доступами к БД
config/config.local.php

# Рабочий каталог целиком: журналы, копии, сессии, локальная база для писем.
#
# Исключение не делается ни для чего, и это осознанно. Отдельные правила на
# `/var/log/` и `/var/*.db` пропускали `var/backup/*.sql` — а это выгрузки базы
# с учениками, классами и работами. Такой файл, однажды попав в историю,
# остаётся там навсегда, сколько его ни удаляй из рабочей копии.
/var/

# Личные данные, которые использовались как образец при написании импорта.
#
# Решение владельца: в публичный репозиторий эта папка не попадает. Проверка
# публикации перечисляет её отдельно и останавливает отправку, если она всё же
# окажется в индексе.
/импорт из OnlineTestPad/

# Заимствованные исходники и сборщик стилей.
#
# Это не часть программы: gentelella — образец, по которому переводилась
# вёрстка, а dart-sass — инструмент сборки CSS. В проекте лежит ~50 МБ, и в
# репозитории им не место: образец при необходимости скачивается заново, а
# собранные стили уже лежат в public/assets/css/.
/resources/

# Зависимости (в проекте их нет, но на всякий случай)
/vendor/
/node_modules/

# Сборки и редакторы
/.idea/
/.vscode/
*.swp

# Ключи и подписи: в репозитории им не место ни при каких условиях
*.pem
*.key
*.p12
*.pfx
*.crx

# ОС
Thumbs.db
.DS_Store

# Временный вход для снимков и проб.
# Файл даёт вход в систему без пароля, поэтому в репозиторий ему нельзя.
public/_shot_tmp.php
public/_probe*.html
public/_probe*.js
public/_session_probe*
public/_enc_probe*
