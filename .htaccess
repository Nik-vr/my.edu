# -----------------------------------------------------------------------------
# Apache на шаред-хостинге, когда корень сайта изменить нельзя.
#
# Нужен, когда каталог сайта — это каталог проекта целиком, а не public/.
# Без него по адресу сайта открывается каталог без index.php, а адреса вида
# /login не доходят до приложения.
#
# Если хостинг позволяет указать корень сайта на каталог public/, этот файл
# не нужен: так безопаснее, и достаточно public/.htaccess.
#
# НА nginx файл не действует — там нужен блок из deploy/.
#
# В файле остались ТОЛЬКО директивы mod_rewrite. Это сделано намеренно.
# Директивы Options, Require, Header и FilesMatch зависят от того, какие
# секции разрешены хостингом через AllowOverride, и если хостинг запрещает
# хоть одну из них, Apache отвечает 500 на все адреса разом — сайт перестаёт
# открываться целиком из-за одного запрещённого слова. mod_rewrite разрешён
# практически везде, где работает .htaccess вообще.
#
# Заголовки безопасности приложение выставляет само в каждом ответе,
# поэтому здесь они не повторяются.
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------------------------
    # 1. Служебное наружу не отдаём.
    #
    # Корень сайта смотрит в каталог проекта, а значит из браузера видны и
    # код, и конфигурация с паролем от базы, и журналы, и дампы. Запрет
    # сформулирован через mod_rewrite ([F,L]) — это вторая по частоте причина
    # неработающего .htaccess после Options/Require.
    # -------------------------------------------------------------------------

    RewriteRule ^(?:src|config|database|plugins|tools|deploy|var|vendor|node_modules|\.git|\.idea|\.vscode)(?:/|$) - [F,L]

  # Каталог tests не закрывается целиком: /tests/... — публичный адрес плагина
  # «Тест», и /tests/task/{id} принимает сохранение задания. Закрыв префикс,
  # мы закрыли бы сам плагин — нажатие «Сохранить» уходило бы в отказ до PHP,
  # и правка терялась. Поэтому запрещаются файлы набора, а не адрес.
  RewriteRule ^tests/(?:run_[\w]+\.php|support/.*|.*\.(?:sql|md|json|lock))$ - [F,L]

    RewriteRule (?:README\.md|changelog\.md|ПРОДОЛЖИТЬ_РАБОТУ\.md|\.gitignore|\.htaccess)$ - [F,L]

    RewriteRule ^composer\.(?:json|lock)$ - [F,L]

    RewriteRule \.(?:sql|log|bak|ini|db|sqlite)$ - [F,L]

    # -------------------------------------------------------------------------
    # 2. Всё остальное — в публичную часть.
    #
    # Адрес в строке браузера при этом не меняется: переход внутренний,
    # поэтому сайт живёт по корневому адресу, а не по /public/.
    #
    # Существующие файлы и каталоги пропускаются: /public/ и /public/uploads/
    # должны отдаваться как есть.
    # -------------------------------------------------------------------------

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [QSA,L]
</IfModule>