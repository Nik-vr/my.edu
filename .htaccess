# -----------------------------------------------------------------------------
# Apache на шаред-хостинге, когда корень сайта изменить нельзя.
#
# Нужен, когда каталог сайта — это каталог проекта целиком, а не public/.
# Без него по адресу сайта открывается каталог без index.php, а адреса вида
# /login не доходят до приложения.
#
# Если хостинг позволяет указать корень сайта на каталог public/, этот файл
# не нужен: так безопаснее, и достаточно public/.htaccess.
#
# НА nginx файл не действует — там нужен блок из deploy/.
#
# В файле остались ТОЛЬКО директивы mod_rewrite. Это сделано намеренно.
# Директивы Options, Require, Header и FilesMatch зависят от того, какие
# секции разрешены хостингом через AllowOverride, и если хостинг запрещает
# хоть одну из них, Apache отвечает 500 на все адреса разом — сайт перестаёт
# открываться целиком из-за одного запрещённого слова. mod_rewrite разрешён
# практически везде, где работает .htaccess вообще.
#
# Заголовки безопасности приложение выставляет само в каждом ответе,
# поэтому здесь они не повторяются.
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------------------------
    # 1. Наружу отдаётся только public/.
    #
    # Правило не перечисляет закрытое, а перечисляет ОТКРЫТОЕ: любой адрес вне
    # public/ уводится внутрь, в public/ того же имени. Там файла нет — и
    # наружу отдаётся 404.
    #
    # Так сделано после чёрного списка каталогов, потому что белый список не
    # приходится пополнять: список закрытого однажды забывают обновить при
    # первом же новом каталоге. Сейчас за каталог можно было попасть прямо —
    # templates/, docs/, tests/, publish.ps1 в чёрном списке не значились, и
    # исходники с журналом разработки отдавались по обычному адресу.
    #
    # Важно, что проверок «файл существует» и «каталог существует» здесь нет:
    # с ними существующий файл вне public/ отдавался как есть, мимо правил
    # вовсе, — а правила как раз и предназначены для таких файлов. Теперь
    # любой такой файл уводится внутрь и там не находится.
    #
    # Адрес в строке браузера не меняется: переход внутренний, поэтому сайт
    # живёт по корневому адресу, а не по /public/.
    # -------------------------------------------------------------------------

    RewriteRule ^(?!public/)(.*)$ public/$1 [QSA,L]
</IfModule>