@echo off
rem ==========================================================================
rem  Остановка сервера проекта.
rem
rem  Двойной щелчок по файлу. Сервер ищется по порту, а не по имени
rem  процесса: процессов php на машине может быть несколько, и убить все
rem  значило бы убить лишнее.
rem
rem  База данных не трогается: её запускает start-server.bat, если она
rem  остановлена. Останавливать её здесь незачем и неправильно — ею пользуются
rem  и другие проекты на этой машине.
rem ==========================================================================

chcp 65001 > nul
setlocal
cd /d "%~dp0"

set "PORT=8088"

echo ============================================================
echo   Остановка сервера my.edu (порт %PORT%)
echo ============================================================
echo.

powershell -ExecutionPolicy Bypass -File "%~dp0tools\stop-dev-server.ps1" -Port %PORT%

echo.
pause
exit /d 0