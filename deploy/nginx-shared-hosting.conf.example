# -----------------------------------------------------------------------------
# nginx на шаед-хостинге, когда корень сайта изменить нельзя.
#
# Случай, который закрывает этот файл: каталог сайта — это каталог проекта
# целиком (файлы .htaccess nginx не читает), а открыть сайт нужно по адресу
# корня, а не по /public/.
#
# Положите блок в панели управления хостингом (ISPmanager, HestiaCP, VestaCP
# и подобные) и поправьте пути. Если панель даёт задать корень сайта на
# каталог public/, воспользуйтесь этим вместо файла: тогда код, конфигурация
# и журналы вообще не попадают в зону видимости веб-сервера, и правила
# закрытия ниже не понадобятся. Для этого случая есть deploy/nginx.conf.example.
#
# -----------------------------------------------------------------------------
# ГЛАВНОЕ, ЧТО ЗДЕСЬ ЛОМАЕТСЯ
#
# root здесь — каталог проекта, а отдавать можно только содержимое public/.
# Поэтому каждый try_files начинается с /public: без этого префикса сервер
# ищет /assets/css/app.css по пути <корень>/assets/css/app.css, там ничего
# нет, запрос уходит во front controller, и страница приходит без стилей.
#
# Правило смотрится непривычно, но /public$uri — это путь относительно root,
# а не адрес: именно поэтому он начинается со слэша.
# -----------------------------------------------------------------------------

server {
    listen 80;
    server_name edu.example.ru;                    # замените на свой домен

    # Корень проекта: каталог, где лежат src, config и сам public/.
    root /home/u123456/public_html;

    # index.php лежит в public/, а не в корне, поэтому адрес корня
    # обслуживается первым правилом try_files ниже, а не директорией.
    index index.php;

    charset utf8mb4;
    client_max_body_size 8m;

    # -------------------------------------------------------------------------
    # 1. Служебное наружу не отдаём.
    #
    # Правила стоят до общего обработчика: nginx берёт первое подошедшее
    # регулярное выражение, поэтому переход в public/ ниже них не сработал бы.
    #
    # После правила 2 эти каталоги и так вне root, но список оставлен: он
    # срабатывает и тогда, когда корень всё-таки указали не туда.
    # -------------------------------------------------------------------------

    location ~* ^/(src|config|database|plugins|tools|tests|deploy|var|vendor|node_modules|\.git|\.idea|\.vscode)(/|$) {
        deny all;
    }

    location ~* \.(md|sql|log|db|sqlite|ini|bak)$ {
        deny all;
    }

    location ~ /\. {
        deny all;
    }

    # -------------------------------------------------------------------------
    # 2. Загрузки: картинки отдаются как картинки, исполняемое внутри —
    # нет. Проверка содержимого в приложении остаётся, но и сервер не должен
    # полагаться только на неё.
    #
    # Загрузки лежат в public/uploads/, поэтому и здесь путь с /public.
    # -------------------------------------------------------------------------

    location ^~ /uploads/ {
        location ~* \.(php|phtml|phar|pl|py|cgi|asp|aspx|sh|shtml|htaccess)$ {
            deny all;
        }

        location ~* \.(jpg|jpeg|png|gif|webp|svg|ico)$ {
            add_header X-Content-Type-Options "nosniff" always;
            expires 30d;
            access_log off;
        }

        try_files /public$uri @front;
    }

    # -------------------------------------------------------------------------
    # 3. Статика и всё остальное — в публичную часть.
    #
    # Существующий файл из public/ отдаётся как есть, всё прочее передаётся
    # во front controller. Адрес при этом в строке браузера не меняется:
    # nginx не переписывает его, меняется только то, какой файл исполнится.
    #
    # Приложение само разберётся, где лежит public/: DOCUMENT_ROOT указывает на
    # каталог проекта, и оно само добавит /public к адресам файлов, оставив
    # навигацию чистой.
    # -------------------------------------------------------------------------

    location / {
        try_files /public$uri /public$uri/ @front;
    }

    location @front {
        rewrite ^ /public/index.php last;
    }

    # Только PHP из public/.
    #
    # Правило на любой .php$ исполняло файлы по всему проекту: /tools/…php,
    # /tests/…php и /src/…php доставались интерпретатору, если адрес до них
    # доходил. Исполняется то, что лежит под public/, всё остальное наружу не
    # отдаётся.
    location ~ ^/public/.+\.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;   # путь зависит от хостинга

        # Внутренний переход выше ведёт на /public/index.php, поэтому
        # $fastcgi_script_name уже содержит /public — приписывать его
        # второй раз нельзя, иначе PHP получит путь public/public/index.php.
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 300;
    }

    # PHP вне public/ не исполняется и не отдаётся: даже если файл попал под
    # корень иначе, до интерпретатора он не дойдёт.
    location ~ \.php$ {
        return 404;
    }

    # -------------------------------------------------------------------------
    # 4. Заголовки безопасности.
    #
    # Приложение выставляет их и само (src/Core/Response.php) — эти дублируют
    # защиту для случая, когда ответ отдаёт не PHP, а nginx: отдаваемые им
    # напрямую картинки и файлы заголовка от приложения не получают.
    # -------------------------------------------------------------------------

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "same-origin" always;

    access_log /home/u123456/logs/my-edu.access.log;
    error_log  /home/u123456/logs/my-edu.error.log;

    gzip on;
    gzip_types text/plain text/css application/javascript image/svg+xml;
    gzip_min_length 512;
}